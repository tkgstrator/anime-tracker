{
  "name": "nagisa-webui",
  "version": "0.1.0",
  "description": "Anime recording management app on Cloudflare Workers with React + Hono + Prisma D1",
  "author": "@QuantumLeap",
  "private": true,
  "license": "MIT",
  "keywords": [
    "anime",
    "cloudflare-workers",
    "hono",
    "react",
    "prisma",
    "d1",
    "vite",
    "typescript"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b --noEmit && vite build --mode ${CLOUDFLARE_ENV:-staging}",
    "prebuild": "rimraf dist",
    "predeploy": "tsc -b --noEmit && vite build --mode ${CLOUDFLARE_ENV:-staging}",
    "deploy": "wrangler deploy --keep-vars --env=${CLOUDFLARE_ENV:-staging}",
    "deploy:lambda": "bun run lambda/fetch/build.ts && terraform -chdir=infra apply -auto-approve"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@base-ui/react": "^1.5.0",
    "@cloudflare/vite-plugin": "^1.40.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@geolonia/japanese-numeral": "^1.0.2",
    "@hono/zod-openapi": "^1.4.0",
    "@logtape/hono": "^2.1.1",
    "@logtape/logtape": "^2.1.1",
    "@prisma/adapter-d1": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@scalar/hono-api-reference": "^0.10.20",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.15",
    "@vitejs/plugin-react": "^6.0.2",
    "@zodios/core": "^10.9.6",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "embla-carousel-react": "^8.6.0",
    "hono": "^4.12.23",
    "jaconv": "^1.1.2",
    "jotai": "^2.20.0",
    "jotai-tanstack-query": "^0.11.0",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "node-html-parser": "^7.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.0",
    "wasm-image-optimization": "^2.0.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@cloudflare/workers-types": "^4.20260607.1",
    "@commitlint/config-conventional": "^21.0.2",
    "@hono/vite-dev-server": "^0.26.0",
    "@msgpack/msgpack": "^3.1.3",
    "@playwright/test": "^1.60.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@tanstack/router-devtools": "^1.167.0",
    "@tanstack/router-plugin": "^1.168.18",
    "@types/bun": "^1.3.14",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "playwright": "^1.60.0",
    "prisma": "^7.8.0",
    "rimraf": "^6.1.3",
    "shadcn": "^4.10.0",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "wrangler": "^4.98.0"
  }
}
