generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

model Anime {
  id              String    @id @default(uuid())
  title           String
  description     String    @default("")
  provider        String // 'amazon' | 'hulu' | 'crunchyroll' | 'abema' | 'netflix'
  contentId       String    @map("content_id")
  entityType      String    @default("tv") @map("entity_type") // 'tv' | 'movie'
  maturityRating  Int?      @map("maturity_rating")
  imageUrl        String    @map("image_url")
  year            Int
  quarter         Int // 0=冬 1=春 2=夏 3=秋
  status          String    @default("UNKNOWN") // FINISHED | RELEASING | NOT_YET_RELEASED | CANCELLED | HIATUS | UNKNOWN
  aniListId       Int       @map("anilist_id")
  badge           String?   // NEW_EPISODE | RECENTLY_ADDED | COMING_SOON
  nextEpisodeDate DateTime? @map("next_episode_date") // 次回エピソード配信日 (UTC)
  expiredAt       DateTime? @map("expired_at") // 配信終了日時 (UTC)
  expiringSeason  Int?      @map("expiring_season") // 対象シーズン番号 (null=作品全体)
  scheduled       Boolean   @default(false) // 録画予約済み
  recorded        Boolean   @default(false) // 録画済み
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  seasons         Season[]

  @@unique([provider, contentId])
  @@index([title])
  @@index([provider])
  @@index([year, quarter])
  @@index([status])
  @@map("anime")
}

model Season {
  id           String    @id @default(uuid())
  animeId      String    @map("anime_id")
  seasonId     String    @map("season_id")
  displayName  String    @map("display_name")
  seasonNumber Int       @map("season_number")
  createdAt    DateTime  @default(now()) @map("created_at")
  anime        Anime     @relation(fields: [animeId], references: [id], onDelete: Cascade)
  episodes     Episode[]

  @@unique([animeId, seasonId])
  @@map("seasons")
}

model Episode {
  id             String   @id @default(uuid())
  seasonId       String   @map("season_id")
  episodeNumber  Int      @map("episode_number")
  episodeId      String   @map("episode_id")
  title          String
  description    String
  releaseDate    DateTime @map("release_date")
  duration       Int      @default(0)
  maturityRating Int?     @map("maturity_rating")
  imageUrl       String   @map("image_url")
  hasSubtitles   Boolean  @default(false) @map("has_subtitles")
  hasDub         Boolean  @default(false) @map("has_dub")
  benefitId      String   @map("benefit_id")
  recorded       Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  season         Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  abemaKey       AbemaKeyArchive?

  @@unique([seasonId, episodeNumber])
  @@map("episodes")
}

/// ABEMA HLS-AES-LEGACY 鍵アーカイブ。
/// 無料配信中の license POST で得た AES-128 content key と segment URL を
/// 永続化しておくと、後で license endpoint を呼ばずに再復号できる。
/// 詳細は nagisa リポジトリ docs/providers/abema/license.md を参照。
model AbemaKeyArchive {
  id                String   @id @default(uuid())
  episodeId         String   @unique @map("episode_id")
  programId         String   @map("program_id") // 例: 25-73_s1_p5
  cid               String   // license response の cid (= program_id と同じ)
  contentKeyHex     String   @map("content_key_hex") // 32 chars (16 bytes hex)
  ivHex             String   @map("iv_hex") // 32 chars (16 bytes hex)
  variantUrl        String   @map("variant_url")
  variantResolution String   @map("variant_resolution") // 例: "1920x1080"
  variantBandwidth  Int      @map("variant_bandwidth") // bps
  segmentUrls       String   @map("segment_urls") // JSON 配列文字列 (D1/SQLite は配列ネイティブ非対応)
  createdAt         DateTime @default(now()) @map("created_at")
  episode           Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@map("abema_key_archives")
}

/// AniList 識別に失敗したタイトルの記録。
/// catalog 同期等で毎回 AniList を叩き直さないよう、未識別タイトルの
/// contentId と最終試行時刻を保存する。再識別したくなったら updatedAt を
/// 見て古いものから cron で叩き直す運用を想定。
model UnidentifiedAnime {
  id        String   @id @default(uuid())
  provider  String
  contentId String   @map("content_id")
  title     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([provider, contentId])
  @@index([provider])
  @@map("unidentified_anime")
}
